# Chave da API do Google (Gemini) - usada pelo rag_indexer.py (embeddings) e
# pelo workflow N8N (embeddings + chamada ao chat). Copie este arquivo para
# ".env" e preencha o valor real. Nunca commite o ".env".
GOOGLE_API_KEY=

# URL do Qdrant. Padrão ao rodar via docker-compose local.
QDRANT_URL=http://localhost:6333

# Token que protege o endpoint POST /admin/executar-pipeline (chamado pelo
# N8N no agendamento diário). Gere qualquer string aleatória longa e use o
# MESMO valor no header "X-Admin-Token" configurado no node HTTP Request do N8N.
ADMIN_TOKEN=

# URL do webhook do workflow N8N "Harus - Chat do Assistente"
# (ver n8n/chat_assistente.json). O backend só repassa a pergunta pra lá.
# Ex: http://n8n:5678/webhook/harus-chat
N8N_CHAT_WEBHOOK_URL=

# URL do webhook de logout do mesmo workflow N8N (node "Webhook Logout") —
# só necessário se quem integrar o widget quiser oferecer esse gatilho.
# Ex: http://n8n:5678/webhook/harus-logout
N8N_LOGOUT_WEBHOOK_URL=

# Token que protege o endpoint POST /rag/buscar (chamado só pelo N8N, nunca
# pelo navegador). Gere uma string aleatória e use o MESMO valor no header
# "X-Internal-Token" do node HTTP Request "Buscar Contexto" no N8N. Opcional:
# se deixar vazio, o endpoint fica sem essa proteção.
INTERNAL_API_TOKEN=

# Origens autorizadas a chamar a API via navegador (CORS), separadas por
# vírgula. Em produção, use o domínio real do site da Harus (harus.ind.br).
# Padrão (se vazio): só localhost, pra rodar a demo local.
ALLOWED_ORIGINS=http://localhost:8000
